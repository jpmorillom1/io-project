
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GROQ_MODEL_NAME=llama-3.3-70b-versatile

CHROMA_URL=http://localhost:8000

DB_URL=jdbc:postgresql://localhost:5432/io_platform
DB_USER=io_user
DB_PASSWORD=io_pass

# Origen público del frontend en producción (ver WebConfig). El navegador manda
# Origin incluso en requests same-origin detrás del reverse proxy de nginx, así
# que el dominio real del deploy tiene que estar acá o el backend responde 403.
CORS_ALLOWED_ORIGINS=http://localhost:*
